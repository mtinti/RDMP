<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RdmpCohortExport</id>
    <version>0.0.1</version>
    <authors>HIC</authors>
    <description>Export a cohort as a runnable script + a catalogue manifest, and rebuild a
      cohort from an exported script (ExportCohortAsScript / ExportCatalogueManifest /
      BuildCohortFromScript). Works from the CLI and the GUI right-click menus.</description>
    <dependencies>
      <!-- major.minor must match the running RDMP (set to your release, e.g. 9.2). -->
      <dependency id="HIC.RDMP.Plugin" version="9.2" />
    </dependencies>
  </metadata>
</package>
