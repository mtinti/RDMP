<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match the target framework of the RDMP build you run inside NHS. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin to the major.minor of the RDMP version running in NHS (see `rdmp --version`).
         The plugin nuget bundles the command-execution + curation APIs used here. -->
    <PackageReference Include="HIC.RDMP.Plugin" Version="*" />
  </ItemGroup>

</Project>
