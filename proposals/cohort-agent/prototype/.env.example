# Copy to .env (or just export these) and adjust to your setup.

# --- LLM (LM Studio defaults; free, local, no Claude API spend) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# The model id shown in LM Studio's "Local Server" tab, e.g. qwen2.5-14b-instruct
LLM_MODEL=local-model
LLM_TEMPERATURE=0.2
# Reasoning models (Nemotron etc.) spend tokens thinking before the answer; too small a
# budget returns empty content. 12000 is comfortable for the grounded Builder prompt.
LLM_MAX_TOKENS=12000

# --- loop ---
MAX_ITERS=4

# --- RDMP backend: leave as mock to prototype with no RDMP/metadata ---
RDMP_BACKEND=mock
# When ready for real builds, set RDMP_BACKEND=real and fill these:
# RDMP_DLL=Tools/rdmp/bin/Release/net10.0/rdmp.dll
# RDMP_DIR=./meta                 # YamlRepository folder (omit to use Databases.yaml)
# DUMP_SQL_CMD=dotnet tools/DumpCohortSql/bin/Release/net10.0/DumpCohortSql.dll {cic_id} --dir {dir}
