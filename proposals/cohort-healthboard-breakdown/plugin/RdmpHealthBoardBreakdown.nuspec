<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RdmpHealthBoardBreakdown</id>
    <version>0.0.1</version>
    <authors>HIC</authors>
    <description>Break a cohort's final inclusion list down by Scottish health board and node,
      joining the cohort identifiers to a demography catalogue's region column and writing a
      per-board / per-node COUNT(DISTINCT chi) to CSV. Works from the CLI
      (ExportCohortHealthBoardBreakdown / ExportCicHealthBoardBreakdown) and the GUI right-click
      menus on a committed cohort or a cohort identification configuration.</description>
    <dependencies>
      <!-- major.minor must match the running RDMP (set to your release, e.g. 9.2). -->
      <dependency id="HIC.RDMP.Plugin" version="9.2" />
    </dependencies>
  </metadata>
</package>
